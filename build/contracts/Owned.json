  "source": "pragma solidity ^0.4.11;\r\n\r\ncontract Owned {\r\n  // State variables\r\n  address owner;\r\n\r\n  //modifiers\r\n  modifier onlyOwner() {\r\n    require(msg.sender == owner);\r\n    _;\r\n  }\r\n\r\n  // constructor\r\n  function Owned(){\r\n    owner = msg.sender;\r\n  }\r\n}\r\n",
